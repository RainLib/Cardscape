":1.45,"foil":0.74,"glare":0.44,"sparkle":0.28,"overlays":[{"pattern":"grating","strength":0.42},{"pattern":"cosmos","strength":0.46}]}},"shader":{"editorMode":"glsl","geometryBody":"q.z += bend * (q.x * q.x - 0.25);\nreturn q;","fragmentPrelude":"const float stormTau = 6.283185307;\nvec3 stormSpectrum(float phase){return .54+.46*cos(stormTau*(phase+vec3(0.,.67,.33)));}\nfloat stormGlint(float x,float w){return exp(-x*x/(w*w));}\nfloat stormLight(float phase){return .70*stormGlint(phase-.508,.028)+.35*stormGlint(phase-.447,.024);}\nfloat stormNoise(vec2 q){return fract(sin(dot(q,vec2(127.1,311.7)))*43758.5453);}","fragmentBody":"float channel = surfaceChannel;\nfloat phase = fract(time*.25);\nfloat turn = atan(-surfaceEye.x,surfaceEye.z);\nfloat lift = atan(surfaceEye.y,length(surfaceEye.xz));\nfloat flash = stormLight(phase);\nfloat sweep = uv.x-uv.y*.68+turn*1.24-lift*.55;\nif(channel<.5) return color;\nif(channel<1.5){\n  float lower = smoothstep(.42,.85,uv.y);\n  float foil = .55 + .45*sin(stormTau*(uv.x*1.5+uv.y*1.95+turn*1.38+lift*.72+.12*cos(uv.y*10.)));\n  vec3 tint = stormSpectrum(uv.y*2.15+uv.x+turn*1.48-.1*cos(phase*stormTau));\n  color.rgb += tint * foil * (.036+.14*lower) + vec3(.13,.046,.27)*flash;\n} else if(channel<2.5){\n  vec2 p=(uv-vec2(.47,.31))*vec2(1.,1.5);\n  float rays=.5+.5*cos(atan(p.y,p.x)*28.+turn*16.+phase*stormTau*2.);\n  vec3 radial=stormSpectrum(atan(p.y,p.x)/stormTau+turn*1.4+.74);\n  color.rgb += radial*(.14+.29*rays)*(.52+.48*cos(phase*stormTau)) + vec3(.35,.16,.55)*flash;\n} else if(channel<3.5){\n  float glass=pow(max(color.b-color.g,0.),1.8);\n  float peak=stormGlint(sweep-.17,.028)+.64*stormGlint(sweep+.32,.046);\n  color.rgb += vec3(.31,.26,.17)*peak + stormSpectrum(.8+turn+uv.y)*glass*1.4;\n  color.rgb += flash*vec3(.20,.095,.26)*smoothstep(.23,.86,max(color.r,color.b));\n} else if(channel<4.5){\n  vec2 p=uv*vec2(1024.,1536.)-vec2(300.,704.);\n  vec2 axis=vec2(-185.,624.);\n  float along=dot(p,axis)/dot(axis,axis);\n  float crossBlade=dot(p,normalize(vec2(axis.y,-axis.x)))+44.*sin(clamp(along,0.,1.)*3.14159265);\n  float hologram=along*1.18+crossBlade*.010+turn*1.68+lift*1.1+.097*sin(stormTau*phase+along*4.);\n  float grating=.5+.5*cos(crossBlade*.67+along*67.-turn*11.);\n  float beam=stormGlint(along-.43-turn*1.1-lift*.36,.096);\n  float charge=stormGlint(along-fract(phase*2.-.115),.103);\n  vec3 rainbow=stormSpectrum(hologram);\n  color.rgb=mix(color.rgb,rainbow*.84+.13,.64)+rainbow*.155*grating;\n  color.rgb+=vec3(.32,.38,.47)*beam+vec3(.28,.16,.38)*(charge*.44+flash)*(.70+.30*grating);\n} else if(channel<6.5){\n  float seed=stormNoise(floor(uv*vec2(98.,149.)));\n  float scintillation=pow(.5+.5*cos(stormTau*(phase+seed)+turn*8.),5.);\n  color.rgb += stormSpectrum(seed+turn)*.22*scintillation;\n  color.a *= .44+.42*scintillation+.42*flash;\n} else {\n  float metal=smoothstep(.14,.38,color.r-color.b) * smoothstep(.27,.63,color.r);\n  color.rgb += vec3(.16,.092,.26)*flash*(.20+.80*metal)*smoothstep(.24,.78,uv.y);\n}\nreturn vec4(clamp(color.rgb,0.,1.),color.a);","fragmentTarget":"all","fragmentMask":"none","fragmentStrength":1},"characterRig":{"schema":"card-character-rig/1","bones":[{"id":"art","name":"人物与刀锋","parentId":null,"x":512,"y":768,"rotation":0,"scale":1},{"id":"eye","name":"符印充能","parentId":null,"x":467,"y":464,"rotation":0,"scale":1},{"id":"ring","name":"环形刻线","parentId":null,"x":481,"y":475,"rotation":0,"scale":1},{"id":"wave","name":"冲击波","parentId":null,"x":481,"y":475,"rotation":0,"scale":1},{"id":"slash","name":"雷弧斩光","parentId":null,"x":115,"y":1328,"rotation":0,"scale":1},{"id":"dust","name":"远层漂移","parentId":null,"x":512,"y":960,"rotation":0,"scale":1},{"id":"pearls","name":"近层漂移","parentId":null,"x":512,"y":960,"rotation":0,"scale":1}],"bindings":[{"layerId":"knight","boneId":"art"},{"layerId":"prism-blade","boneId":"art"},{"layerId":"eye-sigil","boneId":"eye"},{"layerId":"ring-charge","boneId":"ring"},{"layerId":"shockwave","boneId":"wave"},{"layerId":"thunder-slas