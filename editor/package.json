{
  "name": "cardscape",
  "version": "0.19.92",
  "private": true,
  "description": "Cardscape: layered 2.5D card editor powered by Electron, WebGL and Rust",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "native:build": "cargo build --release --manifest-path native/Cargo.toml",
    "native:test": "cargo test --manifest-path native/Cargo.toml",
    "prepare:assets": "node scripts/prepare-assets.cjs",
    "prestart": "npm run build && node scripts/prepare-app-icon.cjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "test": "node --test tests/*.test.cjs",
    "test:sdk": "node scripts/test-godot.cjs",
    "check": "npm run typecheck && npm run build && node scripts/check.cjs",
    "selection:setup": "node scripts/setup-selection.cjs",
    "cutout:setup": "node scripts/setup-cutout.cjs",
    "build:editor": "npm run build",
    "material-maker:setup": "node scripts/setup-material-maker.cjs",
    "build:runtime": "node build/runtime.mts",
    "build": "npm run build:runtime && electron-vite build",
    "prepackage:desktop": "npm run check && npm run native:build -- --locked",
    "package:desktop": "electron-builder --publish never",
    "predev": "npm run build:runtime",
    "dev:web": "npm run build:runtime && node scripts/dev-server.cjs",
    "typecheck": "node build/typecheck.mts",
    "pretest": "npm run build:runtime",
    "test:electron": "npm run build && node scripts/smoke-electron.mts",
    "test:electron:dev": "npm run build && node scripts/smoke-electron.mts --dev",
    "test:player": "npm run build && node scripts/smoke-exported-player.mts",
    "test:production-card": "npm run build && node scripts/verify-production-card.mts",
    "test:production-godot": "node scripts/verify-production-godot.mts",
    "test:contour-authoring": "npm run build && node scripts/smoke-contour-authoring.mts",
    "test:contour-godot": "node scripts/verify-contour-godot.mts",
    "format": "prettier --write renderer/app.ts renderer/core shared build renderer/editing/document-factory.ts renderer/rendering/document-renderer.ts types/ui.d.ts types/platform.d.ts",
    "test:complex-contour": "npm run build && node scripts/smoke-contour-authoring.mts --complex",
    "test:complex-contour-godot": "node scripts/verify-contour-godot.mts --complex",
    "test:contour-materials": "npm run build && node scripts/smoke-contour-authoring.mts --materials",
    "test:contour-materials-godot": "node scripts/verify-contour-godot.mts --materials",
    "perf:cards": "npm run build && node scripts/measure-card-performance.mts",
    "perf:cards:long": "npm run build && node scripts/measure-card-performance.mts --soak=600",
    "benchmark:device:prepare": "npm run build && node scripts/prepare-card-benchmark.mts",
    "benchmark:device:serve": "node scripts/serve-card-benchmark.mts",
    "test:benchmark-device": "node scripts/prepare-card-benchmark.mts && node scripts/smoke-card-benchmark.mts",
    "perf:godot-startup": "node scripts/measure-godot-startup.mts",
    "perf:godot": "node scripts/measure-godot-performance.mts",
    "perf:godot:long": "node scripts/measure-godot-performance.mts --soak-only --soak=600",
    "perf:cards:adaptive": "npm run build && node scripts/measure-card-performance.mts --adaptive"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "electron": "44.7.0",
    "electron-builder": "26.18.0",
    "electron-vite": "^5.0.0",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.14",
    "@shaderfrog/glsl-parser": "7.0.1",
    "clipper2-ts": "2.0.1-18",
    "gifenc": "1.0.3",
    "litegraph.js": "0.7.18",
    "mediabunny": "1.66.2",
    "poly2tri": "1.5.0",
    "polyclip-ts": "0.16.8"
  }
}
