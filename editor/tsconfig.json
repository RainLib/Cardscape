{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "electron/**/*.ts",
    "renderer/**/*.ts",
    "types/**/*.d.ts",
    "electron.vite.config.ts",
    "build/**/*.ts",
    "shared/**/*.ts",
    "build/**/*.mts",
    "scripts/**/*.mts"
  ]
}
