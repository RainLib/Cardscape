extends SceneTree
func _initialize() -> void:
	var library := CardscapeLibrary.new()
	var base := Shader.new()
	base.code="shader_type spatial; render_mode unshaded, depth_draw_never, shadows_disabled; uniform float gain=1.; uniform int frame_finish=1; void fragment(){ALBEDO=vec3(gain); ALPHA=1.;}"
	library.shaders={"test":base}
	assert(library.surface_shader("test",false,false)==base)
	var ordered := library.surface_shader("test",true,false)
	assert(ordered==library.surface_shader("test",true,false),"identical surface render modes reuse the Shader")
	assert("depth_test_disabled" in ordered.code and not "depth_test_disabled" in base.code,"painter order is enabled only on the requested variant")
	var additive := library.surface_shader("test",true,true)
	assert(additive!=ordered and "blend_add" in additive.code,"different blend modes retain different Shader programs")
	var first := ShaderMaterial.new()
	var second := ShaderMaterial.new()
	first.shader=ordered
	second.shader=ordered
	first.set_shader_parameter("gain",.3)
	second.set_shader_parameter("gain",.8)
	assert(is_equal_approx(first.get_shader_parameter("gain"),.3) and is_equal_approx(second.get_shader_parameter("gain"),.8),"instance uniforms remain independent")
	base.code=base.code.replace("vec3(gain)","vec3(gain*.5)")
	assert(library.surface_shader("test",true,false)!=ordered,"changed source invalidates the cached Shader")
	assert(library.surface_shader("missing",true,false)==null)
	var metal:=Shader.new()
	metal.code=base.code.replace("gain*.5","gain*.75")
	library.shaders["test:finish:1"]=metal
	assert(library.surface_shader("test",false,false,1)==metal,"an exported finish selects its specialized program")
	assert(library.surface_shader("test",false,false,2)==base,"unlisted finishes retain generic runtime support")
	assert(library.surface_shader("test",true,false,2)==library.surface_shader("test",true,false,10),"unlisted styles share one generic mode variant")
	var painted:=library.surface_shader("test",true,false,1)
	assert(painted!=library.surface_shader("test",true,false,2),"different finish variants do not thrash a shared mode cache")
	assert(painted==library.surface_shader("test",true,false,1))
	var card:=CardscapeCard.new()
	card.library=library
	var surface:=MeshInstance3D.new()
	var mat:=ShaderMaterial.new()
	mat.shader=painted
	mat.set_shader_parameter("gain",.42)
	surface.material_override=mat
	surface.set_meta("layer_id","probe")
	surface.set_meta("shader_source_key","test")
	surface.set_meta("shader_painter_order",true)
	surface.set_meta("shader_additive",false)
	surface.set_meta("library_shader",painted)
	surface.set_meta("library_shader_code",painted.code)
	card._surfaces.append(surface)
	card._refresh_surface_shader(surface,mat,2)
	assert(mat.shader==library.surface_shader("test",true,false,2))
	assert(is_equal_approx(mat.get_shader_parameter("gain"),.42),"variant switches retain per-instance parameter overrides")
	card._refresh_surface_shader(surface,mat,1)
	assert(mat.shader==painted)
	card.set_effect_parameter("frame_finish",10)
	assert(mat.shader==library.surface_shader("test",true,false,10),"public frame_finish overrides also select the matching program")
	assert(mat.get_shader_parameter("frame_finish")==10 and is_equal_approx(mat.get_shader_parameter("gain"),.42))
	card._refresh_surface_shader(surface,mat,1)
	var custom:=Shader.new()
	custom.code=base.code.replace("gain*.5","gain*.25")
	card.set_custom_shader(custom,"probe")
	card._refresh_surface_shader(surface,mat,2)
	assert(mat.shader==custom,"game-owned custom shaders survive quality/style changes")
	surface.remove_meta("custom_shader_override")
	card._refresh_surface_shader(surface,mat,2)
	assert(mat.shader==custom,"direct shader assignments also remain owned by the game")
	mat.shader=painted
	painted.code=painted.code.replace("gain*.75","gain*.8")
	card._refresh_surface_shader(surface,mat,2)
	assert(mat.shader==painted,"in-place shader edits are not overwritten")
	surface.free()
	card.free()
	print(JSON.stringify({"status":"passed","checks":20,"scope":"shader reuse, finish fallback, per-instance parameters and game overrides"}))
	quit()
